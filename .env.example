# Google Gemini API Key (usada en el navegador)
# Obtiene una gratis en: https://aistudio.google.com/app/apikey
# OJO: al ser una app estatica en GitHub Pages, la key queda visible en el
# codigo publicado. Usa el plan gratuito (rate limits) y/o una key con quotas.
NEXT_PUBLIC_GEMINI_API_KEY=tu_api_key_aqui

# Base path para GitHub Pages (nombre de tu repo). Deja vacio si es la raiz.
# NEXT_PUBLIC_BASE_PATH=/video-to-prompt